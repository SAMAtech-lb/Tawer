# Copy this file to .env and fill in your own values. Never put real values in this file: it is committed to git.

# Neon Postgres connection string (Neon dashboard -> Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Password for the /admin dashboard (12+ characters, not used anywhere else)
ADMIN_PASSWORD="change-me-to-a-long-password"

# Optional: signs admin sessions. If empty, the admin password is used.
SESSION_SECRET=""

# The website's public address (no trailing slash). Used for canonical tags, sitemap.xml and structured data.
SITE_URL="https://www.tawer-academy.com"
